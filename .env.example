# Copy to .env.local and fill in real values. Never commit real keys.

# OpenAI API key used server-side by /api/ai/* (GPT-4o vision + chat).
# Never expose this to the client (do not prefix with NEXT_PUBLIC_).
# Only needed at request time; `npm run build` works without it.
OPENAI_API_KEY=

# Optional: OpenAI model for chat and extraction (defaults to gpt-4o).
# Must support vision and structured outputs.
OPENAI_MODEL=
