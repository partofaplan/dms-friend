# Keep the build context lean and secret-free.

# Secrets — no env file ever enters the image
.env
.env*
**/.env*

# Dependencies / build output (rebuilt inside the image)
node_modules
.next
out
build
dist
coverage
*.tsbuildinfo
next-env.d.ts

# VCS, editor, agent scratch
.git
.gitignore
.kiro
.claude
.claude-*
.codex*
.idea
.vscode
.DS_Store
*.log

# Deployment / docs (not needed to build the app)
Dockerfile
.dockerignore
deploy
*.md
